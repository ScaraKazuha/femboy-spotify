{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Femboy Spotify",
  "version": "0.2.0",
  "identifier": "dev.scarakazuha.femboyspotify",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Femboy Spotify",
        "width": 1480,
        "height": 880,
        "minWidth": 1060,
        "minHeight": 660,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}

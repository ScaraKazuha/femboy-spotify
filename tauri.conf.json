{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Femboy Spotify",
  "version": "0.4.0",
  "identifier": "dev.scarakazuha.femboyspotify",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Femboy Spotify",
        "width": 1480,
        "height": 880,
        "minWidth": 1060,
        "minHeight": 660,
        "center": true,
        "decorations": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFNEFFMEUwQTgwQTA0Q0UKUldUT0JBcW80T0JLZnZ1T1pYemNKdTF1eE91Tnd6N2ZySDBvTVRJWG9vdHcxaWFlS25PMVVCSFMK",
      "endpoints": [
        "https://github.com/ScaraKazuha/femboy-spotify/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}